    "mitt": "^3.0.1",
    "oocss": "^0.1.4",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-drag-resize": "^2.0.3",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.5.1",
